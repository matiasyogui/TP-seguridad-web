# Copiar a `.env`. Valores de laboratorio: NO usar en producción.

PORT=3000

# A PROPOSITO débil (A04 de la Cadena 3): se recupera offline con un diccionario
# (p.ej. hashcat -m 16500). En una app real debe ser un secreto largo y aleatorio.
# Es el mismo valor que fija el documento del TP. NO lo cambies para reproducir la cadena.
JWT_SECRET=

JWT_EXPIRES_IN=1d

# Pausa por paso del análisis, para que el progreso se vea en la demo. 0 = velocidad real.
ANALISIS_PASO_MS=1200
